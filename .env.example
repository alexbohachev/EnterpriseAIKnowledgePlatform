# Example only. Never commit actual secrets to Git.
# Generate with: openssl rand -hex 32
EAKP_JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
EAKP_DB_PASSWORD=REPLACE_WITH_DISTINCT_LONG_RANDOM_DB_PASSWORD
EAKP_NEO4J_PASSWORD=REPLACE_WITH_DISTINCT_LONG_RANDOM_NEO4J_PASSWORD

# Optional monitoring (disabled by default). Copy the SAME random token into
# .secrets/metrics_token (one line, no trailing newline needed).
EAKP_METRICS_TOKEN=
EAKP_OTLP_TRACES_ENDPOINT=
# Required when enabling monitoring profile (never use default admin/admin).
EAKP_GRAFANA_ADMIN_PASSWORD=
