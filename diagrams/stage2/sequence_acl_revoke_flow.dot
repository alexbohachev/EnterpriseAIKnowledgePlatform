digraph G {
 graph [label="Sequence · ACL revocation during concurrent query",labelloc=t,fontsize=20,fontname="Noto Sans",ranksep="0.35",nodesep="0.2",pad="0.18",bgcolor=white];
 node [shape=box,style="rounded,filled",fillcolor="#edf3fa",color="#47698b",fontsize=12,fontname="Noto Sans"];
 edge [fontsize=10,fontname="Noto Sans",color="#596d7f"];
 q1 [label="Q1  Reader: start query\nsnapshot doc grant_epoch=5"];
 q2 [label="Q2  Retrieval: initially permitted\nallowed candidates"];
 a1 [label="A1  Owner → API: revoke user access"];
 a2 [label="A2  PG transaction\ndelete grant; epoch=6; commit",fillcolor="#ffead3"];
 q3 [label="Q3  Before output: DB epoch check\n5 ≠ 6 → BLOCK",fillcolor="#ffead3"];
 q4 [label="Q4  No answer or citations leaked\nretry with new ACL / deny",fillcolor="#f5dfe2"];
 q1->q2->a1->a2->q3->q4;
 note [label="Security invariant: never stream confidential answer\nwithout final permission check.",shape=note,fillcolor="#fff8e6"];
 q3->note [style=dotted,arrowhead=none];
}