digraph Arch {
  graph [rankdir=LR, bgcolor="white", splines=polyline, nodesep=0.45, ranksep=0.7, fontname="DejaVu Sans", fontsize=18];
  node [shape=box, style="rounded,filled", fillcolor="#ecf3fa", color="#26506c", fontname="DejaVu Sans", fontsize=12, margin="0.14,0.10"];
  edge [color="#5c7184", arrowsize=0.65, fontname="DejaVu Sans", fontsize=9];
  User[label="User / JWT"];
  API[label="FastAPI\nACL verified"];
  SQL[label="PostgreSQL\nACL + active run", fillcolor="#fce5c6"];
  Flow[label="LangGraph\nInput → Retrieve → Generate", fillcolor="#dbeade"];
  Q[label="Qdrant\nvector IDs"];
  N[label="Neo4j\nentity graph"];
  O[label="Ollama\nlocal embed + chat", fillcolor="#dbeade"];
  B[label="Private chunk text\nlocal store", fillcolor="#fce5c6"];
  Indexer[label="Indexer\npublish after both"];
  User -> API; API -> SQL [label="SQL authority"];
  API -> Flow; Flow -> SQL [label="revalidate"];
  Flow -> Q; Flow -> N; Flow -> O; Flow -> B;
  Indexer -> Q; Indexer -> N; Indexer -> SQL [label="pointer"];
}
